# Plantilla de configuracion del backend.
# Copiar a `.env` y rellenar con los valores reales:
#     cp backend/.env.example backend/.env

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos MySQL / MariaDB (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autoprime

# Autenticacion
# JWT_SECRET debe ser una cadena larga y aleatoria, distinta en cada entorno.
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=8h
BCRYPT_ROUNDS=10

# Origenes permitidos para CORS, separados por comas
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
