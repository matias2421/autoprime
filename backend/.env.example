# Plantilla de configuracion del backend.
# Copiar a .env y rellenar:  cp .env.example .env
#
# En un servidor no hay .env: Render y compañia inyectan estas mismas
# variables desde su panel. Los nombres son los mismos en los dos sitios.

ENTORNO=desarrollo

# --- Quien puede llamar a la API ---
# Separados por comas. En el despliegue hay que añadir la direccion de Vercel,
# o el navegador bloqueara las peticiones del frontend.
ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Base de datos ---
# Dos formas, y la primera gana si esta puesta.
#
# 1) La cadena entera, que es lo que dan Aiven, Render y demas. Se copia y se
#    pega tal cual, incluso con su ?ssl-mode=REQUIRED: la aplicacion se encarga
#    de traducirla a lo que entiende el driver.
# DATABASE_URL=mysql://usuario:clave@host.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# 2) Por piezas, que es lo comodo en local contra XAMPP.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autoprime

# Certificado de la autoridad del proveedor, si lo ofrece (Aiven lo deja
# descargar como ca.pem). Con el, la conexion va cifrada Y verificada. Sin el,
# se cifra igualmente en modo preferente, pero sin comprobar con quien se habla.
DB_SSL_CA=

# --- Clave de firma de los JWT ---
SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria
ALGORITMO_JWT=HS256
HORAS_EXPIRACION_TOKEN=8
# Vida del enlace de recuperacion de contrasena
MINUTOS_EXPIRACION_RECUPERACION=30
BCRYPT_ROUNDS=10

# --- Correo saliente ---
# Direccion publica del frontend: con ella se arma el enlace del correo. En el
# despliegue apunta al dominio de Vercel, no a localhost, o el enlace que reciba
# el usuario no llevara a ninguna parte.
URL_FRONTEND=http://localhost:5173

# Servidor de correo para enviar el enlace de recuperacion.
# Si se deja SMTP_HOST vacio, el enlace se escribe en el registro del servidor
# en lugar de enviarse, y el flujo se puede probar igual.
#
# Con Gmail hace falta una CONTRASENA DE APLICACION (no la del correo):
#   1. Activa la verificacion en dos pasos en la cuenta de Google.
#   2. Entra en https://myaccount.google.com/apppasswords
#   3. Genera una y pegala en SMTP_PASSWORD, sin espacios.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
# Opcional; por defecto se usa SMTP_USUARIO.
SMTP_REMITENTE=
