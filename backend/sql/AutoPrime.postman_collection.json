      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Guarda el token automaticamente en {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@autoprime.com.co\",\n  \"password\": \"Admin2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token en la variable de entorno para el resto de peticiones.",
                  "const d = pm.response.json();",
                  "if (d.token) {",
                  "  pm.collectionVariables.set('token', d.token);",
                  "  console.log('Token guardado. Rol:', d.usuario.rol);",
                  "}",
                  "pm.test('respuesta correcta', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
