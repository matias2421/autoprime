        {
          "name": "Olvide mi contrasena (paso 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/recuperar",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "recuperar"
              ]
            },
            "description": "Envia el enlace por correo. Responde igual exista o no la cuenta, para no revelar que correos estan registrados, y NO devuelve el token: hay que sacarlo del enlace que llega al buzon.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"cliente@autoprime.com.co\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El token NO vuelve en la respuesta: viaja por correo y solo por correo.",
                  "// Copia el token del enlace que llega al buzon y pegalo en la variable",
                  "// tokenRecuperacion de la coleccion para usar el paso 2.",
                  "const d = pm.response.json();",
                  "pm.test('no expone el enlace', () => pm.expect(d.token).to.be.undefined);",
                  "pm.test('respuesta correcta', () => pm.response.to.have.status(200));",
                  "console.log('Enlace enviado. Valido', d.expiraEnMinutos, 'minutos.');"
                ]
              }
            }
          ]
        },
