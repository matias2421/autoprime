{
  "info": {
    "name": "AutoPrime API - Tercer Avance",
    "description": "Coleccion de pruebas de la API AutoPrime.\n\nSENA - Ficha 3406211 - Jose Matias Agudelo Bolivar\n\nCOMO USARLA:\n1. Enciende MySQL (XAMPP) y el backend (npm run dev en la carpeta backend).\n2. Ejecuta primero 'Login administrador': guarda el token automaticamente en la variable {{token}}.\n3. Las demas peticiones ya usan ese token.\n\nIMPORTANTE: en las peticiones POST/PUT/PATCH el cuerpo va en Body > raw > JSON.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "tokenCliente", "value": "" },
    { "key": "usuarioId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "POST Registro de cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Creado', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.test('NO devuelve la contrasena', () => {",
                  "  const u = pm.response.json().usuario;",
                  "  pm.expect(u.password).to.be.undefined;",
                  "  pm.expect(u.passwordHash).to.be.undefined;",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Documento y correo unicos en cada ejecucion",
                  "const n = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('doc', '11' + n);",
                  "pm.collectionVariables.set('correo', 'cliente' + n + '@correo.com');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"nombre\": \"Laura\",\n  \"apellido\": \"Restrepo\",\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"{{doc}}\",\n  \"direccion\": \"Carrera 7 # 22-14\",\n  \"telefono\": \"3205551188\",\n  \"correo\": \"{{correo}}\",\n  \"password\": \"Furia2026#\",\n  \"confirmarPassword\": \"Furia2026#\"\n}"
            },
            "url": { "raw": "{{base}}/auth/registro", "host": ["{{base}}"], "path": ["auth", "registro"] },
            "description": "Registra un cliente. El backend valida los datos, cifra la contrasena con bcrypt y la guarda en la tabla usuarios."
          }
        },
        {
          "name": "POST Registro con datos invalidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Datos invalidos', () => pm.response.to.have.status(400));",
                  "pm.test('Detalla el error por campo', () => pm.expect(pm.response.json().errores).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"nombre\": \"A\",\n  \"correo\": \"esto-no-es-un-correo\",\n  \"telefono\": \"123\"\n}"
            },
            "url": { "raw": "{{base}}/auth/registro", "host": ["{{base}}"], "path": ["auth", "registro"] },
            "description": "Demuestra que el backend valida por su cuenta, sin depender del formulario de React."
          }
        },
        {
          "name": "POST Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().token;",
                  "pm.collectionVariables.set('token', t);",
                  "pm.test('Genera un JWT de 3 partes', () => pm.expect(t.split('.').length).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"correo\": \"admin@autoprime.com.co\",\n  \"password\": \"Admin2026!\"\n}"
            },
            "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth", "login"] },
            "description": "Valida las credenciales contra el hash bcrypt y devuelve un JWT. El token queda guardado en {{token}}."
          }
        },
        {
          "name": "POST Login cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenCliente', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"correo\": \"cliente@autoprime.com.co\",\n  \"password\": \"Cliente2026!\"\n}"
            },
            "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "POST Login con contrasena erronea (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 No autorizado', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"correo\": \"admin@autoprime.com.co\",\n  \"password\": \"ClaveEquivocada1!\"\n}"
            },
            "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "GET Perfil (token valido)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base}}/auth/perfil", "host": ["{{base}}"], "path": ["auth", "perfil"] },
            "description": "Endpoint protegido: devuelve el usuario del token junto con sus permisos."
          }
        },
        {
          "name": "GET Perfil sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Falta el token', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/auth/perfil", "host": ["{{base}}"], "path": ["auth", "perfil"] }
          }
        }
      ]
    },
    {
      "name": "2. Usuarios (CRUD)",
      "item": [
        {
          "name": "GET Listar usuarios (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Ningun usuario expone su hash', () => {",
                  "  pm.response.json().usuarios.forEach(u => pm.expect(u.passwordHash).to.be.undefined);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base}}/usuarios", "host": ["{{base}}"], "path": ["usuarios"] }
          }
        },
        {
          "name": "GET Listar como cliente (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403 Sin permisos', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCliente}}" }],
            "url": { "raw": "{{base}}/usuarios", "host": ["{{base}}"], "path": ["usuarios"] },
            "description": "El token es valido, pero el rol cliente no tiene permiso: control de roles funcionando."
          }
        },
        {
          "name": "POST Crear usuario (admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('doc2', '22' + n);",
                  "pm.collectionVariables.set('correo2', 'empleado' + n + '@correo.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Creado', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('usuarioId', pm.response.json().usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"nombre\": \"Pedro\",\n  \"apellido\": \"Gomez\",\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"{{doc2}}\",\n  \"direccion\": \"Calle 10 # 20-30\",\n  \"telefono\": \"3109998877\",\n  \"correo\": \"{{correo2}}\",\n  \"password\": \"Pedro2026#\",\n  \"rol\": \"empleado\"\n}"
            },
            "url": { "raw": "{{base}}/usuarios", "host": ["{{base}}"], "path": ["usuarios"] }
          }
        },
        {
          "name": "GET Usuario por id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base}}/usuarios/{{usuarioId}}",
              "host": ["{{base}}"],
              "path": ["usuarios", "{{usuarioId}}"]
            }
          }
        },
        {
          "name": "PUT Actualizar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"nombre\": \"Pedro Andres\",\n  \"telefono\": \"3112223344\"\n}"
            },
            "url": {
              "raw": "{{base}}/usuarios/{{usuarioId}}",
              "host": ["{{base}}"],
              "path": ["usuarios", "{{usuarioId}}"]
            }
          }
        },
        {
          "name": "PATCH Cambiar estado a inactivo",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"estado\": \"inactivo\"\n}"
            },
            "url": {
              "raw": "{{base}}/usuarios/{{usuarioId}}/estado",
              "host": ["{{base}}"],
              "path": ["usuarios", "{{usuarioId}}", "estado"]
            },
            "description": "Se prefiere inactivar antes que borrar, para conservar el historico."
          }
        },
        {
          "name": "DELETE Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base}}/usuarios/{{usuarioId}}",
              "host": ["{{base}}"],
              "path": ["usuarios", "{{usuarioId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Productos",
      "item": [
        {
          "name": "GET Catalogo completo (publico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Trae los 10 vehiculos', () => pm.expect(pm.response.json().productos.length).to.eql(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/productos", "host": ["{{base}}"], "path": ["productos"] },
            "description": "Publico: el catalogo se consulta sin iniciar sesion."
          }
        },
        {
          "name": "GET Filtrar por familia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/productos?familia=edicion",
              "host": ["{{base}}"],
              "path": ["productos"],
              "query": [{ "key": "familia", "value": "edicion" }]
            }
          }
        },
        {
          "name": "GET Un vehiculo por slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/productos/pugnator-tricolore",
              "host": ["{{base}}"],
              "path": ["productos", "pugnator-tricolore"]
            }
          }
        },
        {
          "name": "GET Slug inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 No encontrado', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/productos/no-existe",
              "host": ["{{base}}"],
              "path": ["productos", "no-existe"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Citas (agendamiento)",
      "item": [
        {
          "name": "GET Disponibilidad de una fecha",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date();",
                  "d.setDate(d.getDate() + 7);",
                  "while (d.getDay() === 0) d.setDate(d.getDate() + 1);",
                  "pm.collectionVariables.set('fecha', d.toISOString().slice(0, 10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/citas/disponibilidad?fecha={{fecha}}",
              "host": ["{{base}}"],
              "path": ["citas", "disponibilidad"],
              "query": [{ "key": "fecha", "value": "{{fecha}}" }]
            },
            "description": "Devuelve las franjas del dia marcando cuales estan libres."
          }
        },
        {
          "name": "POST Agendar cita (cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('201 Cita creada', () => pm.response.to.have.status(201));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"hora\": \"11:00\",\n  \"servicioId\": 1,\n  \"productoId\": 1,\n  \"notas\": \"Interesado en financiacion\"\n}"
            },
            "url": { "raw": "{{base}}/citas", "host": ["{{base}}"], "path": ["citas"] }
          }
        },
        {
          "name": "POST Misma franja ocupada (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('409 Franja ocupada', () => pm.response.to.have.status(409));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"hora\": \"11:00\",\n  \"servicioId\": 1,\n  \"productoId\": 1\n}"
            },
            "url": { "raw": "{{base}}/citas", "host": ["{{base}}"], "path": ["citas"] }
          }
        },
        {
          "name": "GET Mis citas (cliente)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCliente}}" }],
            "url": { "raw": "{{base}}/citas", "host": ["{{base}}"], "path": ["citas"] },
            "description": "El cliente solo ve sus propias citas; el admin ve todas."
          }
        }
      ]
    }
  ]
}
